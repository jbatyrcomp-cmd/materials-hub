generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  fullNameKey   String   @unique
  firstName     String
  lastName      String
  passwordHash  String
  role          String   @default("MEMBER") // "ADMIN" | "MEMBER"
  status        String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  preferredLang String   @default("uz") // "uz" | "tk"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  folders           Folder[]
  materials         Material[]
  materialVersions  MaterialVersion[]
  comments          Comment[]
  bookmarks         Bookmark[]
  likes             MaterialLike[]
  createdTasks      DeadlineTask[]
  taskCompletions   TaskCompletion[]
  createdTests      OfficialTest[]
  testAttempts      TestAttempt[]
  flashcardDecks    FlashcardDeck[]
  flashcardProgress FlashcardProgress[]
}

model Subject {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameUz        String
  nameTk        String
  descriptionUz String?
  descriptionTk String?
  icon          String   @default("BookOpen")
  color         String   @default("#3b82f6")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  folders        Folder[]
  materials      Material[]
  deadlineTasks  DeadlineTask[]
  officialTests  OfficialTest[]
  flashcardDecks FlashcardDeck[]
}

model Folder {
  id          String   @id @default(cuid())
  subjectId   String
  parentId    String?
  name        String
  createdById String
  createdAt   DateTime @default(now())

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderHierarchy")
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([subjectId])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  materials MaterialTag[]
}

model Material {
  id             String   @id @default(cuid())
  type           String   // "FILE" | "NOTE" | "LINK" | "VIDEO_LINK" | "AUDIO_LINK"
  title          String
  description    String?
  subjectId      String
  folderId       String?
  authorId       String
  externalUrl    String?
  embedProvider  String?  // "YOUTUBE" | "DRIVE" | "TELEGRAM" | "WEB"
  currentVersion Int      @default(1)
  viewsCount     Int      @default(0)
  downloadsCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject       Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  folder        Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags          MaterialTag[]
  versions      MaterialVersion[]
  comments      Comment[]
  bookmarks     Bookmark[]
  likes         MaterialLike[]
  deadlineTasks DeadlineTask[]

  @@index([subjectId])
  @@index([authorId])
  @@index([type])
}

model MaterialTag {
  materialId String
  tagId      String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([materialId, tagId])
}

model MaterialVersion {
  id            String   @id @default(cuid())
  materialId    String
  versionNumber Int
  noteContent   String?
  fileKey       String?
  fileName      String?
  mimeType      String?
  fileSize      Int?
  changeSummary String?
  editorId      String
  createdAt     DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  editor   User     @relation(fields: [editorId], references: [id], onDelete: Cascade)

  @@unique([materialId, versionNumber])
}

model Comment {
  id         String   @id @default(cuid())
  materialId String
  authorId   String
  parentId   String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  material Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([materialId])
}

model Bookmark {
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([userId, materialId])
}

model MaterialLike {
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([userId, materialId])
}

model DeadlineTask {
  id               String   @id @default(cuid())
  subjectId        String
  linkedMaterialId String?
  title            String
  description      String?
  kind             String   @default("HOMEWORK") // "HOMEWORK" | "EXAM" | "EVENT"
  dueAt            DateTime
  createdById      String
  createdAt        DateTime @default(now())

  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  linkedMaterial Material?        @relation(fields: [linkedMaterialId], references: [id], onDelete: SetNull)
  createdBy      User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  completions    TaskCompletion[]

  @@index([dueAt])
}

model TaskCompletion {
  userId      String
  taskId      String
  completedAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task DeadlineTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
}

model OfficialTest {
  id               String    @id @default(cuid())
  subjectId        String
  title            String
  description      String?
  durationMinutes  Int
  startsAt         DateTime?
  endsAt           DateTime?
  shuffleQuestions Boolean   @default(true)
  isPublished      Boolean   @default(false)
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  questions TestQuestion[]
  attempts  TestAttempt[]
}

model TestQuestion {
  id                   String  @id @default(cuid())
  testId               String
  orderIndex           Int
  type                 String  @default("SINGLE") // "SINGLE" | "MULTI"
  prompt               String
  optionsJson          String
  correctOptionIdsJson String
  points               Int     @default(1)
  explanation          String?

  test OfficialTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model TestAttempt {
  id                String    @id @default(cuid())
  testId            String
  userId            String
  questionOrderJson String?
  answersJson       String    @default("{}")
  startedAt         DateTime  @default(now())
  expiresAt         DateTime
  submittedAt       DateTime?
  score             Int       @default(0)
  maxScore          Int       @default(0)
  durationSeconds   Int       @default(0)

  test OfficialTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([testId, userId])
}

model FlashcardDeck {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cards   Flashcard[]
}

model Flashcard {
  id         String @id @default(cuid())
  deckId     String
  front      String
  back       String
  orderIndex Int    @default(0)

  deck     FlashcardDeck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress FlashcardProgress[]

  @@index([deckId])
}

model FlashcardProgress {
  id             String    @id @default(cuid())
  userId         String
  cardId         String
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, nextReviewAt])
}
