{
  "name": "materials-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Oquw / Materials Hub — Collaborative study materials, notes, tests, flashcards & calendar platform",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:sqlite:generate": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:sqlite:push": "prisma db push --schema=prisma/schema.sqlite.prisma --skip-generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.780.0",
    "@aws-sdk/s3-request-presigner": "^3.780.0",
    "@prisma/client": "^6.6.0",
    "clsx": "^2.1.1",
    "jose": "^6.0.10",
    "katex": "^0.16.21",
    "lucide-react": "^0.488.0",
    "next": "^15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
