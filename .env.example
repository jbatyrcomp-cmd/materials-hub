# PostgreSQL connection string (Neon / Supabase / Docker PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/materialshub?sslmode=require"

# Session JWT Secret (generate a strong 32+ char random string in production)
SESSION_SECRET="dev-session-secret-change-this-in-production-32chars"

# Storage Provider ("local" for dev, "s3" for Vercel + Cloudflare R2 / S3)
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="50"

# S3 / Cloudflare R2 / Supabase Storage (required when STORAGE_PROVIDER="s3")
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
